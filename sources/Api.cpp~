void luaopenApi(lua_State* L)
{
    for (const luaL_Reg* lib = libs; lib->func; lib += 1) {
        lua_pushcfunction(L, lib->func, NULL);
        lua_pushstring(L, lib->name);
        lua_call(L, 1, 0);
    }
}
